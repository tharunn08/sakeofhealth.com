# ═══════════════════════════════════════════════════════════════
#  Sake of Health — Environment Configuration
#  Copy to .env and fill in your values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000
BRAND_NAME=Sake of Health

# ─── ADMIN LOGIN (change these!) ──────────────────────────────
# These are the credentials you use at /admin/
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=TeMP@2026
# Secret used to sign admin session tokens — set to a long random string
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=12

# ─── PAYMENTS ─────────────────────────────────────────────────
# TESTING MODE: true = orders complete without real charges.
# Set to false and add live keys below before going live.
PAYMENT_MOCK=true

# Razorpay  https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# 3b.4: the same keys refund "paid but short" online-shop payments (only when stock enforcement is on
# and a person with shop_stock.refund.pay presses Refund, or automatic refunds are approved).
# Development and testing: Razorpay TEST keys only (rzp_test_...). Never put live keys in a test machine.

# Cashfree (optional fallback)  https://merchant.cashfree.com/
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# ─── EMAIL (order confirmations) ──────────────────────────────
# Gmail: use an App Password, not your account password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sake of Health <orders@sakeofhealth.com>

# ─── WHATSAPP (order notifications) ───────────────────────────
# Option A — Meta WhatsApp Cloud API (recommended)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Option B — Twilio WhatsApp  https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

DEFAULT_COUNTRY_CODE=91

# Approved Meta templates. Business-initiated WhatsApp messages outside the customer's
# 24-hour window must use an approved template (utility for order/account updates).
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
# Queued business messages carry a logical template name (e.g. whatsapp_otp); map each
# to its approved Meta template name with WHATSAPP_TEMPLATE_<NAME> (else the name is used as is).
WHATSAPP_TEMPLATE_WHATSAPP_OTP=
# Event counter invoices (3b.5) go by WhatsApp only when this approved utility template is set;
# the template takes one body parameter (the invoice link). Without it the invoice goes by email only.
WHATSAPP_TEMPLATE_EVENT_INVOICE=
# Delivery reports (sent / delivered / read / failed) from Meta:
# webhook URL https://<your-site>/api/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ─── SMS (MSG91, DLT-registered templates only) ───────────────
# Template ids per logical name: MSG91_TEMPLATE_<NAME>, e.g. MSG91_TEMPLATE_ORDER_OTP.
# Delivery reports: https://<your-site>/api/webhooks/msg91?token=<MSG91_WEBHOOK_TOKEN>
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ORDER_OTP=
MSG91_WEBHOOK_TOKEN=

# A message counts as sent only when a provider accepted it. With no provider configured,
# queued business messages are marked "Not sent: no provider" (never "sent").

# ─── MAPS (address lookup) ────────────────────────────────────
# Optional. Without a key the site uses free OpenStreetMap.
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ─── STORE SETTINGS ───────────────────────────────────────────
SHIPPING_FEE=49
FREE_SHIPPING_ABOVE=499
COD_ENABLED=true
DELIVERY_DAYS=4
ORDER_PREFIX=SOH
SUPPORT_EMAIL=support@sakeofhealth.com
SUPPORT_PHONE=+917483927125

# ─── ANALYTICS (optional) ─────────────────────────────────────
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_CODE=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ─── DATABASE ─────────────────────────────────────────────────
# CRITICAL — read this before deploying to Hostinger (or any host where
# "redeploy" replaces your site folder with a fresh copy of the repo):
#
# By default data is stored at ~/sakeofhealth-data (your hosting account's
# home directory), which normally survives redeploys since only the site
# folder inside it gets replaced. BUT some Node.js hosting panels (including
# some Hostinger setups) point the app's HOME at the site folder itself —
# in that case the "safe" default folder gets wiped too, and this is almost
# certainly why your reviews/orders disappeared after redeploying.
#
# The fix: set DATA_DIR below to an ABSOLUTE path OUTSIDE your site/repo
# folder — e.g. a sibling folder in your hosting account, or your
# hPanel-provided persistent storage path. Example:
#   DATA_DIR=/home/yourhostingusername/sakeofhealth-data
# After setting this in your host's environment variables panel, redeploy
# once and check the server startup log line "[DB] Using data directory:"
# to confirm it points to the path you set, not somewhere inside the repo.
DATA_DIR=
AUTO_SEED=true


# ═══════════════════════════════════════════════════════════════
#  B2B — RETAILER & DISTRIBUTOR PLATFORM
#  Everything below is OPTIONAL. With B2B_ENABLED=false the customer
#  website runs exactly as before and no database is contacted.
# ═══════════════════════════════════════════════════════════════

# Master switch. Keep false until the MySQL database below is created,
# migrated (npm run migrate) and you have tested the portal.
B2B_ENABLED=true

# ─── MySQL (Hostinger hPanel → Databases → MySQL Databases) ───
# On Hostinger the host is usually "localhost" when the Node app and the
# database are on the same hosting plan. Use a SEPARATE database for
# development — never point a local machine at the production database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root@123
DB_NAME=sakeofhealth_b2b_dev
DB_POOL_SIZE=8

# Migrations are NOT run on deploy unless this is true. Recommended: leave
# false and run "npm run migrate" (or Admin → B2B Settings → System →
# Run migrations) after taking a backup.
DB_AUTO_MIGRATE=false

# ─── B2B security ─────────────────────────────────────────────
# Signs retailer / distributor login sessions. Use a long random string
# (32+ characters), different from ADMIN_JWT_SECRET. Changing it logs
# every business user out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
B2B_JWT_SECRET=gfeasuijoidfjskakldjfkslakdjfksasljdskalJSDKALsjdf
B2B_SESSION_HOURS=72

# Private folder for GST certificates, shop proofs and import files.
# MUST be an absolute path OUTSIDE the site folder / public_html so the
# files are never served by the web server and survive redeploys.
#   B2B_PRIVATE_DIR=/home/yourhostingusername/sakeofhealth-private
B2B_PRIVATE_DIR=
B2B_MAX_UPLOAD_MB=5
B2B_MAX_IMPORT_MB=15

# Public address of the site, used in emails and on printed labels.
PUBLIC_SITE_URL=https://www.sakeofhealth.com
# N3: promotional emails carry an unsubscribe link built from PUBLIC_SITE_URL (or SITE_URL) and signed
# with ERP_JWT_SECRET. Without a site address, promotional email is refused (nothing is sent).
# 3b.5: event invoice links (/api/erp/public/invoice?t=...) are built from PUBLIC_SITE_URL and signed
# with ERP_JWT_SECRET; without a site address the invoice is still printable in the admin, but no link is sent.
# Provider throughput (messages per minute) is a business setting: erp.notifications.provider_rates
# (default email 30, WhatsApp 60, SMS 60) — set it to the limits of the plans you buy.
# WhatsApp: replies STOP / START to your number are read from the same webhook (WHATSAPP_APP_SECRET).

# Who is told about new registrations / orders needing approval
# (comma separated). Can also be set in Admin → B2B Settings → Notifications.
OWNER_EMAIL=

# Razorpay webhook secret (Dashboard → Settings → Webhooks). Needed only
# if business customers pay online; the webhook URL is
#   https://your-domain/api/b2b/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ─── Backups (npm run backup) ─────────────────────────────────
# Absolute path outside the site folder. Default: ~/sakeofhealth-backups
BACKUP_DIR=
BACKUP_KEEP=14
