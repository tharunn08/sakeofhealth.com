{
  "name": "sake-of-health",
  "version": "2.0.0",
  "description": "Sake of Health — B2C storefront, admin panel and B2B retailer/distributor platform",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "node scripts/build.js",
    "dev": "node --watch scripts/dev.js",
    "seed": "node src/seed.js",
    "reset": "node scripts/reset-dev.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:verify": "node scripts/migrate.js verify",
    "b2b:seed-dev": "node scripts/seed-b2b-dev.js",
    "backup": "node scripts/backup.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:b2c": "node --test tests/b2c-regression.test.js",
    "verify:products": "node scripts/protected-products.js verify",
    "restore:shop": "node scripts/restore-shop.js",
    "setup": "node scripts/setup-env.js",
    "secrets": "node scripts/generate-secrets.js",
    "check:env": "node scripts/check-env.js",
    "env:templates": "node scripts/env-templates.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^6.9.13",
    "razorpay": "^2.9.2"
  }
}
