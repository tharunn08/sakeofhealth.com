# ══════════════════════════════════════════════════════════════════════
#  Sake of Health — local development (generated; do not edit by hand).
#  npm run setup copies this to .env and fills every <generated> secret with a fresh random value.
#  Payments run in mock mode; the business platform stays off until you set up a local MySQL test database.
# ══════════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────
# production on the live site. Production turns on every safety check below. [required]
NODE_ENV=development
# Port to listen on. Hostinger sets it for you — leave it empty there. [optional; default 3000]
PORT=3000
# Address of the online shop, used in order e-mails and payment links. [required in production]
SITE_URL=http://localhost:3000
# Public address used in trade-portal e-mails, unsubscribe links, invoice links and printed labels
# (falls back to SITE_URL). [required when B2B_ENABLED=true]
PUBLIC_SITE_URL=http://localhost:3000
# When true (the production default) the server refuses to start while any variable below is
# missing or invalid. false = start anyway and log every problem — emergencies only. [optional;
# default true in production]
CONFIG_STRICT=
# Name shown in e-mails, invoices and the admin. [optional; default Sake of Health]
BRAND_NAME=Sake of Health

# ─── Shop admin and customer sign-in ───────────────────────────────
# Root shop administrator sign-in e-mail. [required in production]
ADMIN_EMAIL=admin@example.local
# Root shop administrator password (12+ characters). Change it after the first sign-in. [required
# in production]
ADMIN_PASSWORD=<generated>
# Signs shop-admin sessions. Without it admin sign-in is switched off. Changing it signs every
# admin out. [required in production]
ADMIN_JWT_SECRET=<generated>
# Admin session length in hours. [optional; default 12]
ADMIN_SESSION_HOURS=12
# Signs customer sessions on the shop. Without it customer accounts are switched off. [required in
# production]
CUSTOMER_JWT_SECRET=<generated>
# Customer session length in days. [optional; default 30]
CUSTOMER_SESSION_DAYS=30
# Old name of B2B_JWT_SECRET. Do not set it on new installations. [optional]
JWT_SECRET=

# ─── Shop data, protected products and backups ─────────────────────
# Shop data folder (orders, products, customers…). In production an ABSOLUTE path OUTSIDE the site
# folder — on Hostinger under /home/<user>/, never inside domains/<domain>/hbuilds or public_html,
# which every deploy overwrites. [required in production; default ~/sakeofhealth-data]
DATA_DIR=
# Product snapshots and the protected-products change log, outside the site folder. [required in
# production; default ~/sakeofhealth-catalogue]
CATALOGUE_DIR=
# Daily and manual backups (npm run backup), outside the site folder. [required in production;
# default ~/sakeofhealth-backups]
BACKUP_DIR=
# How many manual backups to keep. [optional; default 14]
BACKUP_KEEP=14
# When true (the production default) the server will not start if the four protected products fail
# the integrity check. Set false only to start in an emergency; /api/health then shows
# protectedProducts:false. [optional; default true in production]
PROTECTED_PRODUCTS_STRICT=
# Development only: fill an empty shop with the demo catalogue. Ignored in production (no demo
# data there). [optional; default true]
AUTO_SEED=true
# Development only: add demo orders and reviews too. [optional; default false]
SEED_DEMO_DATA=false

# ─── Shop settings ─────────────────────────────────────────────────
# Shipping charge in rupees. [optional; default 49]
SHIPPING_FEE=49
# Order value from which shipping is free. [optional; default 499]
FREE_SHIPPING_ABOVE=499
# Promised delivery time shown to customers. [optional; default 4]
DELIVERY_DAYS=4
# Prefix of order numbers. [optional; default SOH]
ORDER_PREFIX=SOH
# Support address shown to customers. [optional]
SUPPORT_EMAIL=support@sakeofhealth.com
# Support phone shown to customers. [optional]
SUPPORT_PHONE=
# Country code added to 10-digit mobile numbers. [optional; default 91]
DEFAULT_COUNTRY_CODE=91
# Most units of one product in one online order. [optional; default 20]
B2C_MAX_LINE_QTY=

# ─── Payments (Razorpay) ───────────────────────────────────────────
# Development only: orders complete without a real payment. Ignored (and reported) in production.
# [optional; default false]
PAYMENT_MOCK=true
# Razorpay key id (rzp_live_… on the live site, rzp_test_… anywhere else). [required in
# production]
RAZORPAY_KEY_ID=
# Razorpay key secret, from the same dashboard page as the key id. [required when RAZORPAY_KEY_ID
# is set]
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (Settings → Webhooks); needed for webhooks at /api/b2b/webhooks/razorpay
# and the shop webhook. [optional]
RAZORPAY_WEBHOOK_SECRET=

# ─── E-mail (SMTP) ─────────────────────────────────────────────────
# SMTP server. Empty = no e-mail is sent (messages are recorded as "not sent"). [optional]
SMTP_HOST=
# SMTP port (465 with SMTP_SECURE=true, 587 otherwise). [optional; default 587]
SMTP_PORT=587
# true for port 465 (TLS from the start). [optional; default false]
SMTP_SECURE=false
# SMTP user name (usually the full mailbox address). [required when SMTP_HOST is set]
SMTP_USER=
# SMTP password (for Gmail an App Password). [required when SMTP_HOST is set]
SMTP_PASS=
# From address of every e-mail. [required when SMTP_HOST is set]
SMTP_FROM=
# Who is told about new trade registrations and orders needing approval (comma separated).
# [optional]
OWNER_EMAIL=

# ─── WhatsApp ──────────────────────────────────────────────────────
# Meta WhatsApp Cloud API access token. Empty = no WhatsApp messages. [optional]
WHATSAPP_TOKEN=
# Meta WhatsApp phone number id. [required when WHATSAPP_TOKEN is set]
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret: checks delivery reports and STOP/START replies at /api/webhooks/whatsapp.
# [optional]
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in Meta when you register the webhook. [required when
# WHATSAPP_APP_SECRET is set]
WHATSAPP_VERIFY_TOKEN=
# Approved Meta template for order confirmations. [optional]
WHATSAPP_ORDER_TEMPLATE=
# Approved Meta template for order status updates. [optional]
WHATSAPP_STATUS_TEMPLATE=
# Language code of the templates. [optional; default en_US]
WHATSAPP_TEMPLATE_LANG=en_US
# Approved template for event counter invoices (one parameter: the invoice link). [optional]
WHATSAPP_TEMPLATE_EVENT_INVOICE=
# Maps a logical message name (e.g. WHATSAPP_TEMPLATE_WHATSAPP_OTP) to its approved Meta template
# name. [optional]
# WHATSAPP_TEMPLATE_EXAMPLE=
# Alternative to Meta: Twilio WhatsApp account SID. [optional]
TWILIO_ACCOUNT_SID=
# Twilio auth token. [required when TWILIO_ACCOUNT_SID is set]
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender number. [required when TWILIO_ACCOUNT_SID is set]
TWILIO_WHATSAPP_FROM=

# ─── SMS (MSG91) ───────────────────────────────────────────────────
# MSG91 auth key (DLT-registered templates only). Empty = no SMS. [optional]
MSG91_AUTH_KEY=
# Token in the MSG91 delivery-report URL /api/webhooks/msg91?token=… [optional]
MSG91_WEBHOOK_TOKEN=
# MSG91 template id per logical message name, e.g. MSG91_TEMPLATE_ORDER_OTP. [optional]
# MSG91_TEMPLATE_EXAMPLE=

# ─── Maps and analytics ────────────────────────────────────────────
# Google Maps key for address lookup; empty = free OpenStreetMap. [optional]
GOOGLE_MAPS_API_KEY=
# Meta pixel id. [optional]
META_PIXEL_ID=
# Meta Conversions API token. [optional]
META_ACCESS_TOKEN=
# Meta test event code (testing only). [optional]
META_TEST_CODE=
# Google Analytics 4 measurement id. [optional]
GA4_MEASUREMENT_ID=
# GA4 Measurement Protocol secret. [optional]
GA4_API_SECRET=

# ─── Business database (MySQL) ─────────────────────────────────────
# Turns on the trade portal and the business database. Keep false until the database is created,
# backed up and migrated. [optional; default false]
B2B_ENABLED=false
# MySQL host (Hostinger: usually localhost). [required when B2B_ENABLED=true]
DB_HOST=127.0.0.1
# MySQL port. [optional; default 3306]
DB_PORT=3306
# MySQL user (hPanel → Databases). [required when B2B_ENABLED=true]
DB_USER=
# MySQL password. [required when B2B_ENABLED=true]
DB_PASSWORD=
# MySQL database name. Use a separate database for development and a throw-away one for tests.
# [required when B2B_ENABLED=true]
DB_NAME=sakeofhealth_dev
# Connections in the pool. Shared hosting: keep 4–8 (each connection counts against the MySQL user
# limit). [optional; default 6]
DB_POOL_SIZE=6
# Run migrations at start. Keep false in production: take a backup and run npm run migrate
# yourself. [optional; default false]
DB_AUTO_MIGRATE=false
# Only together with a reviewed "-- allow-destructive" migration. Never leave true. [optional;
# default false]
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# ─── Trade portal (retailers and distributors) ─────────────────────
# Signs retailer and distributor sessions; different from every other secret. [required when
# B2B_ENABLED=true]
B2B_JWT_SECRET=<generated>
# Trade-portal session length. [optional; default 72]
B2B_SESSION_HOURS=72
# Private documents (KYC, supplier documents, import files) — absolute path outside the site
# folder; never served to the web. [required when B2B_ENABLED=true in production; default
# ~/sakeofhealth-private]
B2B_PRIVATE_DIR=
# Largest upload. [optional; default 5]
B2B_MAX_UPLOAD_MB=5
# Largest Excel import. [optional; default 15]
B2B_MAX_IMPORT_MB=15
# Requests per minute per trade-portal user. [optional; default 400]
B2B_RATE_PER_MIN=
# Requests per minute per staff user on trade admin APIs. [optional; default 600]
B2B_ADMIN_RATE_PER_MIN=
# How often the in-process notification sender runs (JOBS_MODE=inprocess only). [optional; default
# 30]
B2B_NOTIFY_INTERVAL_SECONDS=

# ─── Back office (business platform) ───────────────────────────────
# Turns on the business platform (needs B2B_ENABLED=true too). [optional; default false]
ERP_ENABLED=false
# Signs business-staff sessions, unsubscribe and invoice links; 48+ characters in production,
# different from every other secret. [required when B2B_ENABLED=true and ERP_ENABLED=true]
ERP_JWT_SECRET=<generated>
# Encrypts 2FA secrets and bank account numbers (AES-256-GCM). Set it before the first bank
# account or 2FA is saved and NEVER change or lose it — data encrypted with it cannot be read
# without it. Keep a copy in your password manager. Without it the older key derived from
# ERP_JWT_SECRET is used (then ERP_JWT_SECRET must never change). [optional]
ENCRYPTION_KEY=<generated>
# Server override for two-step sign-in of business staff. Leave EMPTY to use the switch in
# Administration → My Password & 2FA (never switched = off). true or false forces it on or off and
# locks that switch; set false to get back in after losing an authenticator. [optional; default
# empty: use the in-app switch]
ERP_MFA_REQUIRED=
# Business-staff session length. [optional; default 8]
ERP_SESSION_HOURS=8
# Signed out after this many idle minutes. [optional; default 60]
ERP_IDLE_MINUTES=60
# In-process job timer (JOBS_MODE=inprocess only). [optional; default 30000]
ERP_WORKER_INTERVAL_MS=

# ─── File storage (uploads, invoices, documents) ───────────────────
# Where uploaded business files (trade KYC documents, supplier documents, manufacturing documents,
# proof-of-delivery photos) are kept: local = B2B_PRIVATE_DIR on this server, s3 = an
# S3-compatible service (Cloudflare R2, Backblaze B2, AWS S3). Shop product images are part of the
# site, not uploads. [optional; default local]
STORAGE_PROVIDER=local
# S3 endpoint, e.g. https://<account>.r2.cloudflarestorage.com or
# https://s3.<region>.backblazeb2.com. [required when STORAGE_PROVIDER=s3]
STORAGE_ENDPOINT=
# Bucket name (private bucket). [required when STORAGE_PROVIDER=s3]
STORAGE_BUCKET=
# Region (R2: auto; B2/AWS: the bucket region). [optional; default auto]
STORAGE_REGION=
# Access key id with read/write on that bucket only. [required when STORAGE_PROVIDER=s3]
STORAGE_ACCESS_KEY=
# Secret access key. [required when STORAGE_PROVIDER=s3]
STORAGE_SECRET_KEY=

# ─── Scheduled jobs (Hostinger Cron Jobs) ──────────────────────────
# cron = background work runs only from Hostinger Cron Jobs (scripts/cron/run-jobs.js), as
# Business hosting requires; inprocess = timers inside the web process (development). [optional;
# default inprocess (cron in production)]
JOBS_MODE=inprocess
# Lets a cron job call POST /api/internal/cron/run with the header X-Cron-Secret instead of
# running the script. Empty = that URL is switched off. [optional]
CRON_SECRET=<generated>
# Most jobs one cron run claims. [optional; default 50]
JOB_BATCH_SIZE=50
# A cron run stops claiming new jobs after this many seconds (Hostinger stops a cron job after 30
# minutes and an HTTP request after 120 s; the HTTP trigger caps it at 90 s). [optional; default
# 240]
JOB_TIME_BUDGET_SECONDS=240

# ─── AI assistant (off until set and switched on) ──────────────────
# Language-model provider for the AI assistant. Only anthropic (Claude) is built in. Leave empty
# to keep the assistant off. [optional; default empty: assistant off]
AI_PROVIDER=
# API key from the provider's console. Billed per use by the provider; set a monthly spending
# limit there. [required when AI_PROVIDER is set]
AI_API_KEY=
# Model name; the default is the low-cost one. [optional; default claude-haiku-5-5]
AI_MODEL=
# Questions per person per day. [optional; default 30]
AI_DAILY_LIMIT_PER_USER=
# Questions per day for the whole business. [optional; default 300]
AI_DAILY_LIMIT_TOTAL=

